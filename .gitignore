# ---- Результати збірки ----
bin/
obj/
*.dll
# Reference assemblies (public API only, no game code) for CI builds;
# regenerate with tools/Update-GameRefs.ps1 after a game update.
!lib/*.dll
*.pdb
*.mdb
*.user
*.suo

# ---- Локальні шляхи до гри ----
# Environment.props містить шлях до вашої інсталяції Valheim
# і не має потрапляти в репозиторій (у кожного він свій).
Environment.props

# ---- Ігрові та BepInEx збірки ----
# Пропрієтарні файли гри — НІКОЛИ не комітити.
valheim_Data/
Managed/
publicized_assemblies/
libs/
*.nupkg

# ---- IDE ----
.vs/
.vscode/
.idea/
assetripper-export/
*.csproj.user
*.sln.DotSettings.user

# ---- Інше ----
*.log
.DS_Store
Thumbs.db
artifacts/
