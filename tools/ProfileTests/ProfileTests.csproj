<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the shipped LayerProfile against real profile files. Unity components
    cannot be created outside the engine, so the assertions use Resolve(), which
    shares the parse and the guards with Apply.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>9</LangVersion>
    <AssemblyName>ProfileTests</AssemblyName>
    <RootNamespace>ProfileTests</RootNamespace>
    <ModSourceDir>$(MSBuildProjectDirectory)\..\..</ModSourceDir>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>ModSourceDir</_Parameter1>
      <_Parameter2>$(ModSourceDir)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Import Project="..\..\Environment.props" Condition="Exists('..\..\Environment.props')" />

  <PropertyGroup>
    <ValheimDir Condition="'$(ValheimDir)' == ''">$(MSBuildProjectDirectory)\..\..\..\..</ValheimDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(ValheimDir)\BepInEx</BepInExDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(ValheimDir)\valheim_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\LayerProfile.cs" Link="LayerProfile.cs" />
    <Compile Include="..\..\MiniJson.cs" Link="MiniJson.cs" />
    <Compile Include="..\..\DynamicOverride.cs" Link="DynamicOverride.cs" />
    <Compile Include="..\..\RadialSelection.cs" Link="RadialSelection.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>

</Project>
